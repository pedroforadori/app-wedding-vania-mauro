# Stripe — deixe em branco para rodar em modo de simulação (checkout-simulado)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Protege o GET /api/rsvp (usado pelo painel /admin-confirmados via import direto,
# que não depende deste header). Defina um valor forte antes de ir para produção.
ADMIN_API_SECRET=

# URL pública do site — opcional; /api/checkout já deriva a origin da própria requisição
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data/hora do casamento em ISO 8601 (usada pelo Countdown e pelo rodapé)
NEXT_PUBLIC_WEDDING_DATE=2026-10-17T16:00:00-03:00

# Nomes do casal (opcional; fallback "Vania & Mauro" no código)
NEXT_PUBLIC_COUPLE_NAMES="Vania & Mauro"
