# Stripe — deixe em branco para rodar em modo de simulação (checkout-simulado)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Pix (Copia e Cola / QR Code) — pagamento manual, sem gateway: o código Pix
# é gerado por aqui mesmo, a partir da chave estática do casal. Sem essas três
# variáveis definidas, a opção de pagar via Pix simplesmente não aparece no site.

# Chave Pix do casal (CPF, CNPJ, e-mail, celular ou chave aleatória/EVP)
PIX_KEY=

# Nome do recebedor exibido no app de quem paga — máx. 25 caracteres, sem
# acentos (o padrão do Banco Central para o BR Code exige texto ASCII simples)
PIX_MERCHANT_NAME=

# Cidade do recebedor — máx. 15 caracteres, sem acentos
PIX_MERCHANT_CITY=

# Redis (Upstash) — persiste a lista de confirmados e os pedidos de Pix. Na Vercel: Storage →
# Create Database → Upstash Redis; as variáveis KV_REST_API_URL/KV_REST_API_TOKEN
# são injetadas automaticamente. Rodando localmente, copie os mesmos valores
# do painel da Vercel/Upstash para cá (ou use UPSTASH_REDIS_REST_URL/TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protege o GET /api/rsvp (usado pelo painel /admin-confirmados via import direto,
# que não depende deste header). Defina um valor forte antes de ir para produção.
ADMIN_API_SECRET=

# URL pública do site — opcional; /api/checkout já deriva a origin da própria requisição
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data/hora do casamento em ISO 8601 (usada pelo Countdown e pelo rodapé)
NEXT_PUBLIC_WEDDING_DATE=2026-10-17T16:00:00-03:00

# Nomes do casal (opcional; fallback "Vania & Mauro" no código)
NEXT_PUBLIC_COUPLE_NAMES="Vania & Mauro"
